# Copy to keystore.properties (gitignored) to override the release signing key.
# Without this file the build uses %USERPROFILE%\.t3widget\signing\t3widget.keystore
# with the standard Android debug credentials. Env vars T3WIDGET_KEYSTORE,
# T3WIDGET_KEYSTORE_PASSWORD, T3WIDGET_KEY_ALIAS and T3WIDGET_KEY_PASSWORD also work.
# Every update MUST be signed with the same key as the installed app.
storeFile=C:/path/to/t3widget.keystore
storePassword=android
keyAlias=androiddebugkey
keyPassword=android
